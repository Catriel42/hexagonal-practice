<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.jala.edu.user.infrastructure.adapter.in.ui.ListUsersController">

    <HBox styleClass="toolbar">
        <Label styleClass="page-title" text="User list"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="messageLabel" styleClass="message"/>
        <Button fx:id="editButton" text="Edit" onAction="#onEdit"/>
        <Button fx:id="deleteButton" styleClass="danger" text="Delete" onAction="#onDelete"/>
        <Button fx:id="refreshButton" text="Refresh" onAction="#onRefresh"/>
    </HBox>

    <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN"/>
        </columnResizePolicy>
        <placeholder>
            <Label text="No users yet. Create one from the Users main view."/>
        </placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="Name" prefWidth="170"/>
            <TableColumn fx:id="emailColumn" text="Email" prefWidth="210"/>
            <TableColumn fx:id="phoneColumn" text="Phone" prefWidth="110"/>
            <TableColumn fx:id="roleColumn" text="Role" prefWidth="90"/>
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="80"/>
            <TableColumn fx:id="createdAtColumn" text="Created at" prefWidth="130"/>
        </columns>
    </TableView>
</VBox>
